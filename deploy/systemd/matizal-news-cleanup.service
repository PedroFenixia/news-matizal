[Unit]
Description=Matizal News - limpieza mensual de retención (día 5, 03:00 Europe/Madrid)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/opt/news-matizal/.env
ExecStart=/usr/bin/curl -fsS -X POST -H "x-cron-secret: ${CRON_SECRET}" http://127.0.0.1:3021/api/cron/cleanup
StandardOutput=append:/var/log/matizal-news/cleanup.log
StandardError=append:/var/log/matizal-news/cleanup.log
