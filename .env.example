# Copia este fichero a .env (local) o crea el .env real en el VPS con
# permisos 600. NUNCA comitees el .env real con valores reales.

# --- Sitio ------------------------------------------------------------------

# URL pública final del sitio. TODA URL absoluta de la app (Open Graph,
# canonical, sitemap, compartir) se genera a partir de esta variable.
# En local puedes dejarla vacía y caerá a http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://news.matizal.com

# --- IA (OpenAI) --------------------------------------------------------------

# Clave de API de OpenAI. Requerida para generar briefings reales (no
# necesaria solo para ver los datos demo).
OPENAI_API_KEY=

# Proveedor de IA activo. Hoy solo "openai" está implementado (ver
# lib/ai/index.ts); la interfaz está preparada para añadir otros.
AI_PROVIDER=openai

# Configuración CENTRALIZADA de modelos (ver lib/ai/model-config.ts) — nunca
# hardcodees un nombre de modelo en otro sitio del código.
#
# FAST: clasificación, relevancia, deduplicación semántica, detección de
# novedades en las revisiones intradía (14:00/19:00). Tarea mecánica, se
# beneficia de un modelo barato.
OPENAI_MODEL_FAST=gpt-4o-mini
#
# EDITORIAL: resumen ejecutivo, síntesis, comparación editorial, redacción
# final del briefing completo (10:00). Por defecto también gpt-4o-mini —
# ya sostiene la calidad editorial de Matizal News con un coste bajo; solo
# súbelo a un modelo más caro si decides que la calidad lo justifica (evita
# usar el modelo más caro disponible por defecto, ver sección 13 del brief).
OPENAI_MODEL_EDITORIAL=gpt-4o-mini

# --- Cron / endpoints protegidos ---------------------------------------------

# Secreto compartido para autorizar /api/cron/daily, /api/cron/intraday,
# /api/cron/cleanup y /api/refresh. Genera un valor aleatorio largo, por
# ejemplo con:
#   openssl rand -hex 32
CRON_SECRET=

# Secreto del panel de diagnóstico /admin/usage (coste/telemetría de
# OpenAI) — independiente de CRON_SECRET, se pasa como ?secret=... en la
# URL del navegador. Sin esta variable definida, /admin/usage rechaza
# cualquier acceso (nunca queda abierto por accidente).
ADMIN_SECRET=

# --- Presupuesto (protección de coste, sección 12 del brief) -----------------

# Límites opcionales en EUR. Si se superan, la siguiente ejecución (edición
# completa o revisión intradía) se aborta ANTES de llamar a OpenAI — no se
# genera contenido nuevo, pero la última edición válida se mantiene visible
# tal cual. Déjalas vacías para no aplicar ningún límite.
OPENAI_DAILY_BUDGET_EUR=
OPENAI_MONTHLY_BUDGET_EUR=

# --- Base de datos ------------------------------------------------------------

# Ruta de la base de datos SQLite. En producción (VPS) debe apuntar FUERA
# del directorio del repo/build, para que sobreviva a git pull + rebuild.
# En local, si se omite, cae a ./data/dev.sqlite dentro del proyecto.
DATABASE_PATH=/var/lib/matizal-news/db.sqlite
