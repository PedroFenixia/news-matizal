# Copia este fichero a .env (local) o crea el .env real en el VPS con
# permisos 600. NUNCA comitees el .env real con valores reales.

# --- Sitio ------------------------------------------------------------------

# URL pública final del sitio. TODA URL absoluta de la app (Open Graph,
# canonical, sitemap, compartir) se genera a partir de esta variable.
# En local puedes dejarla vacía y caerá a http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://news.matizal.com

# --- IA (OpenAI) --------------------------------------------------------------

# Clave de API de OpenAI. Requerida para generar briefings reales (no
# necesaria solo para ver los datos demo).
OPENAI_API_KEY=

# Proveedor de IA activo. Hoy solo "openai" está implementado (ver
# lib/ai/index.ts); la interfaz está preparada para añadir otros.
AI_PROVIDER=openai

# Modelo de OpenAI a usar.
OPENAI_MODEL=gpt-4o-mini

# --- Cron / endpoints protegidos ---------------------------------------------

# Secreto compartido para autorizar /api/cron/daily, /api/cron/cleanup y
# /api/refresh. Genera un valor aleatorio largo, por ejemplo con:
#   openssl rand -hex 32
CRON_SECRET=

# --- Base de datos ------------------------------------------------------------

# Ruta de la base de datos SQLite. En producción (VPS) debe apuntar FUERA
# del directorio del repo/build, para que sobreviva a git pull + rebuild.
# En local, si se omite, cae a ./data/dev.sqlite dentro del proyecto.
DATABASE_PATH=/var/lib/matizal-news/db.sqlite
